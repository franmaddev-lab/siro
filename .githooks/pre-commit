#!/bin/sh
# Stops a commit that adds something that looks like a secret.
# Enabled per clone with: git config core.hooksPath .githooks
if git diff --cached --name-only --diff-filter=A | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "Blocked: an .env file is staged. Secrets belong in Netlify environment variables." >&2
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -E -i \
  '(sk_live_[0-9a-z]{10,}|sk_test_[0-9a-z]{10,}|ghp_[0-9a-z]{30,}|github_pat_[0-9a-z_]{30,}|nfp_[0-9a-z]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ntfy\.sh/[a-z0-9_-]{12,})' >/dev/null; then
  echo "Blocked: the staged changes contain something that looks like a secret or private address." >&2
  echo "Remove it, or run git commit --no-verify if it is a false alarm." >&2
  exit 1
fi
