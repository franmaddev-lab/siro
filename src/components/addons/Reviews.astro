---
import site from '../../../site.config'
import DemoTag from '../DemoTag.astro'
const a = site.addons.reviews
const urlFor = (name?: string) => a.sources.find((x) => x.name === name)?.url
---
{a.mode !== 'off' && (
  <section class="section reviews" id="reviews">
    <div class="container">
      <div class="head">
        <h2>{a.heading || 'What customers say'} <DemoTag mode={a.mode} /></h2>
        {a.rating && (
          <p class="summary"><span class="big">{a.rating}</span><span class="stars" aria-hidden="true">★★★★★</span>{a.count && <span>from {a.count} reviews</span>}</p>
        )}
      </div>
      <div class="grid cols-3">
        {a.items.map((r) => (
          <a class="card review" href={urlFor(r.source)} target="_blank" rel="noopener">
            <figure>
              <p aria-label={`${r.stars} out of 5 stars`} class="stars">{'★'.repeat(r.stars)}</p>
              <blockquote>“{r.text}”</blockquote>
              <figcaption>{r.name}{r.source && <span class="src">on {r.source} ↗</span>}</figcaption>
            </figure>
          </a>
        ))}
      </div>
      {a.sources.length > 0 && (
        <p class="more">{a.sources.map((x) => <a class="btn invert" href={x.url} target="_blank" rel="noopener">Read our reviews on {x.name} ↗</a>)}</p>
      )}
    </div>
  </section>
)}
<style>
  .reviews { background: var(--brand); color: var(--brand-text); }
  .head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .summary { display: flex; align-items: baseline; gap: 0.6rem; margin: 0; }
  .big { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 700; }
  figure { margin: 0; color: var(--ink); }
  blockquote { margin: 0 0 0.75rem; font-family: var(--font-heading); font-size: 1.15rem; }
  figcaption { color: var(--muted); }
  .stars { color: #c9877f; letter-spacing: 0.1em; margin: 0 0 0.5rem; }
  .summary .stars { color: var(--surface); }
  .more { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  .review { display: block; text-decoration: none; transition: transform 0.15s; }
  .review:hover { transform: translateY(-3px); }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; }
  .src { font-size: 0.85rem; color: var(--brand); }
  .btn.invert { background: var(--brand-text); color: var(--brand); border-color: var(--brand-text); }
</style>
