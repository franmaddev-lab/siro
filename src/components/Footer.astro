---
import site from '../../site.config'
import SocialIcons from './SocialIcons.astro'
const c = site.contact
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="container top">
    <div>
      <p class="name">{site.name}</p>
      {c.address && <p class="small">{c.address}</p>}
      {c.phone && <p class="small"><a href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a>{c.email && <> · <a href={`mailto:${c.email}`}>{c.email}</a></>}</p>}
    </div>
    <p class="icons"><SocialIcons /></p>
  </div>
  <div class="container legal">
    <a href="/cookies/">Cookie policy</a>
    <button type="button" class="linkish" data-cookie-settings>Cookie settings</button>
    <span>© {year} {site.name}</span>
  </div>
</footer>
<style>
  .site-footer { background: var(--ink); color: var(--paper); padding: 2rem 0 5rem; margin-top: 0; }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .legal { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--paper) 15%, transparent); font-size: 0.85rem; opacity: 0.85; }
  .icons { display: flex; gap: 0.6rem; margin: 0; }
  .icons :global(.social:hover svg) { color: var(--ink); }
  p { margin: 0 0 0.25rem; }
  .small { font-size: 0.9rem; opacity: 0.9; }
  .name { font-family: var(--font-heading); font-size: 1.2rem; }
  a, .linkish { color: inherit; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; cursor: pointer; }
  @media (max-width: 640px) { .site-footer { padding: 1.5rem 0 4.5rem; } }
</style>
