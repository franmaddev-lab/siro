---
import site from '../../site.config'
const c = site.contact
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="name">{site.name}</p>
      {c.address && <p>{c.address}</p>}
      {c.area && <p>Serving {c.area}</p>}
    </div>
    <div>
      {c.phone && <p><a href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a></p>}
      {c.email && <p><a href={`mailto:${c.email}`}>{c.email}</a></p>}
      {site.social.facebook && <p><a href={site.social.facebook} rel="noopener">Facebook</a></p>}
      {site.social.instagram && <p><a href={site.social.instagram} rel="noopener">Instagram</a></p>}
    </div>
    <div>
      <p><a href="/cookies/">Cookie policy</a></p>
      <p><button type="button" class="linkish" data-cookie-settings>Cookie settings</button></p>
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--ink); color: var(--paper); padding: 2.5rem 0 5rem; margin-top: 0; }
  .cols { display: grid; gap: 1.5rem; }
  @media (min-width: 640px) { .cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  p { margin: 0 0 0.4rem; }
  .name { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; }
  a, .linkish { color: inherit; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; cursor: pointer; }
</style>
