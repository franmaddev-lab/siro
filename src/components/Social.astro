---
import site from '../../site.config'
import SocialIcons from './SocialIcons.astro'
const s = site.social
// Whole rows only: 2 across on phones, 4 on wider screens, so trim to a multiple of 4.
const photos = s.photos.slice(0, Math.floor(s.photos.length / 4) * 4 || s.photos.length)
---
{s.showSection && (s.instagram || s.facebook) && (
  <section class="section alt" id="follow">
    <div class="container">
      <p class="eyebrow">Follow along</p>
      <h2>Specials, events and new dishes first on {s.handle || 'social media'}</h2>
      {s.instagram && photos.length > 0 && (
        <div class="strip">
          {photos.map((p) => <a href={s.instagram} rel="noopener"><img src={p.src} alt={p.alt} loading="lazy" /></a>)}
        </div>
      )}
      <p class="actions icons"><SocialIcons /></p>
    </div>
  </section>
)}
<style>
  .strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 1.5rem; }
  @media (min-width: 760px) { .strip { grid-template-columns: repeat(4, 1fr); } }
  .strip img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); transition: transform 0.2s; }
  .strip a:hover img { transform: scale(1.02); }
  .icons { color: var(--brand); justify-content: center; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
</style>
