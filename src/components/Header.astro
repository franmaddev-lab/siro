---
import site from '../../site.config'
import LogoFull from './LogoFull.astro'
const links = [
  ...(site.addons.priceList.mode !== 'off' ? [{ href: '/#prices', label: site.addons.priceList.heading || 'Prices' }] : []),
  ...(site.addons.reviews.mode !== 'off' ? [{ href: '/#reviews', label: 'Reviews' }] : []),
  { href: '/#about', label: 'Who we are' },
  { href: '/#contact', label: 'Get in touch' },
]
const path = Astro.url.pathname
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={site.name}>
      {site.logo.svg ? <LogoFull /> : site.name}
    </a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      {site.addons.booking.mode !== 'off' && <a class="btn small" href="/#book">{site.hero.cta}</a>}
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); background: var(--paper); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; padding: 0.9rem 0; }
  .brand { font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; color: var(--ink); text-decoration: none; }
  nav { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  nav a { color: var(--ink); text-decoration: none; padding: 0.4rem 0; font-weight: 600; }
  nav a[aria-current='page'] { color: var(--brand); box-shadow: 0 2px 0 var(--brand); }
</style>
<style>
  nav .btn.small { padding: 0.45rem 1rem; color: var(--brand-text); }
</style>
<style>
  .brand { display: block; color: var(--brand); line-height: 0; }
  .brand :global(svg) { height: 4.5rem; width: auto; }
  @media (max-width: 640px) { .brand :global(svg) { height: 3.5rem; } }
</style>
