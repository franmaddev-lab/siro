---
import site from '../../site.config'
import LogoMark from './LogoMark.astro'
// Home page with the big hero logo: start with the header logo hidden (phones), so it never flashes.
const startHidden = Astro.url.pathname === '/' && site.hero.showLogo && site.logo.svg
const links = [
  ...(site.addons.priceList.mode !== 'off' ? [{ href: '/#prices', label: site.addons.priceList.heading || 'Prices' }] : []),
  ...(site.addons.reviews.mode !== 'off' ? [{ href: '/#reviews', label: 'Reviews' }] : []),
  { href: '/#about', label: 'Who we are' },
  { href: '/#contact', label: 'Get in touch' },
]
---
<header class:list={['site-header', { 'logo-in-hero': startHidden }]} data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={site.name}>
      {site.logo.svg
        ? <LogoMark icon />
        : site.name}
    </a>
    <div class="right">
      <button type="button" class="burger" aria-expanded="false" aria-controls="main-nav" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav id="main-nav" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid color-mix(in srgb, var(--brand-text) 12%, transparent); background: var(--brand); color: var(--brand-text); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 1.5rem; padding: 0.9rem 0; }
  .brand { display: block; color: #f2bfcb; line-height: 0; text-decoration: none; }
  .lockup { display: inline-flex; align-items: center; gap: 0.9rem; }
  .brand :global(svg) { height: 2.6rem; width: auto; }
  .sub { display: flex; flex-direction: column; gap: 0.35rem; padding-left: 0.9rem; border-left: 1.5px solid color-mix(in srgb, #f2bfcb 60%, transparent); font-family: var(--font-body); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase; line-height: 1; color: var(--brand-text); }
  nav { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  nav a { color: var(--brand-text); text-decoration: none; padding: 0.4rem 0; font-weight: 600; }
  nav a:hover { color: #f2bfcb; }
  .btn.small { padding: 0.45rem 1rem; color: var(--brand-text); }
  .right { display: none; align-items: center; gap: 0.75rem; }
  .burger { width: 2.75rem; height: 2.75rem; border: 0; background: transparent; display: grid; align-content: center; gap: 5px; padding: 0.6rem; cursor: pointer; }
  .burger span { display: block; height: 2px; background: var(--brand-text); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 899px) {
    .brand :global(svg) { height: 2.2rem; }
    .sub { font-size: 0.55rem; letter-spacing: 0.28em; gap: 0.3rem; padding-left: 0.7rem; }
    .lockup { gap: 0.7rem; }
    .right { display: flex; }
    .book-desktop { display: none; }
    nav { display: none; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem 0 0.75rem; }
    nav a { padding: 0.9rem 0; font-size: 1.1rem; border-top: 1px solid color-mix(in srgb, var(--brand-text) 15%, transparent); }
    .site-header.open nav { display: flex; }
  }
  /* Phones, home page: the big logo sits in the hero; once it scrolls away the small one appears here. */
  @media (max-width: 899px) {
    .brand { transition: opacity 0.35s ease, transform 0.35s ease; transform-origin: left center; }
    .site-header.logo-in-hero .brand { opacity: 0; transform: translateY(1.5rem) scale(1.6); pointer-events: none; }
  }
</style>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]')
  const burger = header?.querySelector<HTMLButtonElement>('.burger')
  const setOpen = (open: boolean) => { header?.classList.toggle('open', open); burger?.setAttribute('aria-expanded', String(open)) }
  burger?.addEventListener('click', () => setOpen(!header?.classList.contains('open')))
  header?.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
  // Home page on phones: hide the header logo while the hero logo is on screen.
  const heroLogo = document.querySelector('.hero-logo')
  if (header && heroLogo && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => header.classList.toggle('logo-in-hero', e.isIntersecting), { rootMargin: '-60px 0px 0px 0px' }).observe(heroLogo)
  }
</script>
