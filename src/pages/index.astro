---
import site from '../../site.config'
import Base from '../layouts/Base.astro'
import PriceList from '../components/addons/PriceList.astro'
import Booking from '../components/addons/Booking.astro'
import Gallery from '../components/addons/Gallery.astro'
import Reviews from '../components/addons/Reviews.astro'
import Quote from '../components/addons/Quote.astro'
import WhyUs from '../components/WhyUs.astro'
import HowItWorks from '../components/HowItWorks.astro'
import LogoFull from '../components/LogoFull.astro'
import Social from '../components/Social.astro'
import About from '../components/About.astro'
import Contact from '../components/Contact.astro'
const ss = site.servicesSection
const quoteOn = site.addons.quote.mode !== 'off'
const h = site.hero
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        {h.eyebrow && <p class="eyebrow">{h.eyebrow}</p>}
        <h1>{h.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
        <p class="lead">{h.text.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
        <p class="actions">
          {site.addons.priceList.mode !== 'off' && <a class="btn" href="#prices"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M12 6.5C10.5 5 8 4.5 3 4.5v14c5 0 7.5.5 9 2 1.5-1.5 4-2 9-2v-14c-5 0-7.5.5-9 2Zm0 0v14"/></svg>See the {site.addons.priceList.heading.toLowerCase() || 'prices'}</a>}
          <a class="btn" href="#contact"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 5h16v11H9l-5 4Z"/></svg>Get in touch</a>
        </p>
        {h.badges.length > 0 && <ul class="badges">{h.badges.map((b) => <li>{b}</li>)}</ul>}
        <p class="where">
          {site.contact.address && <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.contact.address)}`} target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>{site.contact.address}</a>}
          {site.contact.hours[0] && <a href="#contact"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{site.contact.hours[0].days}, {site.contact.hours[0].time}</a>}
        </p>
      </div>
      {h.showLogo ? <div class="hero-logo"><LogoFull animate /></div> : h.image && <img src={h.image} alt="" />}
    </div>
  </section>

  {site.services.length > 0 && (
  <section class="section" id="services">
      <div class="container">
        {ss.eyebrow && <p class="eyebrow">{ss.eyebrow}</p>}
        <h2>{ss.heading}</h2>
        {ss.intro && <p class="lead">{ss.intro}</p>}
        <div class="grid cols-3 services-grid">
          {site.services.map((s) => (
            <div class="card"><h3>{s.name}</h3><p class="muted">{s.text}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <PriceList />
  <Gallery />
  {site.cta.heading && (
    <section class="section cta">
      <div class="container">
        <h2>{site.cta.heading}</h2>
        <p>{site.cta.text}</p>
        <p class="actions">
          <a class="btn invert" href={quoteOn ? '#quote' : site.addons.booking.mode !== 'off' ? '#book' : '#contact'}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 5h16v11H9l-5 4Z"/></svg>{h.cta}</a>
          {site.contact.phone && <a class="btn invert" href={`tel:${site.contact.phone.replace(/\s/g, '')}`}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>Call now</a>}
        </p>
      </div>
    </section>
  )}

  <WhyUs />
  <About />
  <Social />
  <HowItWorks />
  <Booking />
  <Quote />



  <Reviews />
  <Contact />
</Base>
<style>
  .hero { padding: clamp(3.5rem, 9vw, 6.5rem) 0; background: var(--surface); }
  .hero h1 { font-weight: 800; max-width: none; }
  .badges { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-weight: 600; }
  .badges li::before { content: '✓'; color: var(--brand); margin-right: 0.5rem; }
  .hero .break { flex-basis: 100%; height: 0; }
  .where { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .where a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .where a:hover { border-bottom-color: currentColor; }
  .services-grid { margin-top: 2rem; }
  .cta { background: var(--brand); color: var(--brand-text); text-align: center; }
  .cta h2 { max-width: none; }
  .cta .actions { justify-content: center; }
  .btn.invert { background: var(--brand-text); color: var(--brand); border-color: var(--brand-text); }
  .btn.ghost { background: transparent; color: var(--brand-text); border-color: var(--brand-text); }
  /* Hero links: curly font with a hand-drawn underline that draws itself on hover. */
  .links { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin-top: 1.75rem; }
  .ul-link { position: relative; font-family: var(--font-heading); font-size: 1.55rem; color: #f2bfcb; text-decoration: none; padding-bottom: 0.35rem; white-space: nowrap; }
  .ul-link svg { position: absolute; left: 0; bottom: -0.2rem; width: 100%; height: 0.8rem; overflow: visible; }
  .ul-link path { fill: none; stroke: #f2bfcb; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 320; stroke-dashoffset: 120; transition: stroke-dashoffset 0.5s ease; }
  .ul-link:hover path, .ul-link:focus-visible path { stroke-dashoffset: 0; }
  .ul-link .arrow { display: inline-block; transition: transform 0.25s; }
  .ul-link:hover .arrow, .ul-link:focus-visible .arrow { transform: translateX(0.4rem); }
  @media (max-width: 640px) { .ul-link { font-size: 1.3rem; } .links { gap: 1rem 1.75rem; } }
  .ico { width: 1.15em; height: 1.15em; margin-right: 0.5em; vertical-align: -0.2em; }
  .hero-logo { color: #f2bfcb; max-width: 30rem; justify-self: center; width: 100%; }
  @media (min-width: 1000px) { .hero-grid:has(.hero-logo) { grid-template-columns: 1.1fr 1fr; } }
  .hero-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 1000px) { .hero-grid:has(img) { grid-template-columns: 1.1fr 1fr; } }
  .hero img { border-radius: var(--radius); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
</style>
