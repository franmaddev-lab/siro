---
import site from '../../site.config'
import Base from '../layouts/Base.astro'
const a = site.about
---
<Base title={a.heading}>
  <section class="section">
    <div class="container about">
      <div>
        <h1>{a.heading}</h1>
        {a.paragraphs.map((p) => <p>{p}</p>)}
        <p><a class="btn" href="/contact/">Get in touch</a></p>
      </div>
      {a.image && <img src={a.image} alt="" />}
    </div>
  </section>
</Base>
<style>
  .about { display: grid; gap: 2rem; align-items: start; }
  .about > div { max-width: 42rem; }
  @media (min-width: 1000px) { .about:has(img) { grid-template-columns: 1.2fr 1fr; } }
  img { border-radius: var(--radius); }
</style>
